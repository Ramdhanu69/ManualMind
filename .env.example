# --- Django ---
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL 16) ---
# Docker Compose: host "db". Local Postgres: host "127.0.0.1".
POSTGRES_DB=manualmind
POSTGRES_USER=manualmind
POSTGRES_PASSWORD=manualmind
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Vector backend ---
# numpy   = default, zero-risk, runs on stock Postgres with no extension
# pgvector = optional, requires the "vector" extension (run: manage.py enable_pgvector)
VECTOR_BACKEND=numpy

# --- Embeddings ---
# EMBEDDING_PROVIDER: fake | openai_compatible | gemini | sentence_transformers
# EMBEDDING_DIM must match the model. Changing the model requires: manage.py reindex_all
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake-hash-384
EMBEDDING_DIM=384
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
# Examples:
#   OpenAI          EMBEDDING_PROVIDER=openai_compatible EMBEDDING_MODEL=text-embedding-3-small EMBEDDING_DIM=1536
#   Ollama          EMBEDDING_PROVIDER=openai_compatible EMBEDDING_BASE_URL=http://localhost:11434/v1 EMBEDDING_MODEL=nomic-embed-text EMBEDDING_DIM=768
#   LM Studio       EMBEDDING_PROVIDER=openai_compatible EMBEDDING_BASE_URL=http://localhost:1234/v1 EMBEDDING_MODEL=text-embedding-bge-small-en-v1.5 EMBEDDING_DIM=384
#   Gemini          EMBEDDING_PROVIDER=gemini EMBEDDING_MODEL=text-embedding-004 EMBEDDING_DIM=768
#   Local ST        EMBEDDING_PROVIDER=sentence_transformers EMBEDDING_MODEL=BAAI/bge-small-en-v1.5 EMBEDDING_DIM=384

# --- LLM ---
# LLM_PROVIDER: fake | openai_compatible | gemini | anthropic
LLM_PROVIDER=fake
LLM_MODEL=fake-llm
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.0
# Examples:
#   OpenAI     LLM_PROVIDER=openai_compatible LLM_MODEL=gpt-4o-mini
#   Ollama     LLM_PROVIDER=openai_compatible LLM_BASE_URL=http://localhost:11434/v1 LLM_MODEL=llama3.1
#   Gemini     LLM_PROVIDER=gemini LLM_MODEL=gemini-2.0-flash
#   Anthropic  LLM_PROVIDER=anthropic LLM_MODEL=claude-sonnet-4-5

# --- Retrieval gate (calibrate with: manage.py eval_rag) ---
# Gate 1 only skips a hopeless retrieval; it is NOT the out-of-scope filter.
# Measured with EMBEDDING_PROVIDER=fake on the student pack: answerable questions
# score 0.120-0.633 and out-of-scope ones 0.374-0.429, so the two overlap and the
# honest refusal has to come from gate 2 (the structured model verdict). 0.10 sits
# below the lowest answerable score. Re-run eval_rag after changing EMBEDDING_MODEL,
# because the score scale is model-specific.
RETRIEVAL_MIN_SCORE=0.10

# --- Demo seed passwords (manage.py seed_demo) ---
DEMO_ADMIN_PASSWORD=Demo@1234
DEMO_ENGINEER_PASSWORD=Demo@1234
DEMO_SUPERVISOR_PASSWORD=Demo@1234
